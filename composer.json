{
    "name": "kodiakv2/bedrock-protocol",
    "description": "AST-driven C++ library generator for the Minecraft Bedrock protocol.",
    "type": "project",
    "require": {
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "kodiak\\bedrockprotocol\\generator\\": "tools/generator/"
        }
    },
    "scripts": {
        "generate": [
            "php tools/generate.php",
            "php tools/tests/GeneratePacketCoverage.php"
        ],
        "clean": "php tools/clean.php",
        "generate-tests": "php tools/tests/GeneratePacketCoverage.php",
        "parity": "php tools/tests/ProtocolParity.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
