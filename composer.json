{
    "name": "kodiakv2/bedrock-protocol",
    "description": "AST-driven C++ library generator for the Minecraft Bedrock protocol.",
    "type": "project",
    "require": {
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "kodiak\\bedrockprotocol\\generator\\": "tools/generator/"
        }
    },
    "scripts": {
        "generate": "php tools/generate.php",
        "clean": "php tools/clean.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
